#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -euo pipefail

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"

indent() { sed -u 's/^/       /'; }
header() { echo "-----> $*"; }
log()    { echo "       $*"; }

# tree does not exist on Heroku by default, so we implement a simple version
tree() {
  find $1 |
    grep -v 'node_modules' |
    sed -e "s/[^-][^\/]*\// |/g" -e "s/|\([^ ]\)/|-\1/"
}

inspect_dir() {
  local dir_to_inspect="$1"

  header "Inspecting directory: $dir_to_inspect"
  if [ -d "$dir_to_inspect" ]; then
    log "$dir_to_inspect exists"

    tree "$dir_to_inspect" | indent
  else
    log "$dir_to_inspect does not exist"
  fi
}

header "BUILD_DIR: $BUILD_DIR"
header "CACHE_DIR: $CACHE_DIR"
header "ENV_DIR: $ENV_DIR"

header "Tree of root"
inspect_dir "$PWD"

header "Tree of build dir"
inspect_dir "$BUILD_DIR"

header "Tree of cache dir"
inspect_dir "$CACHE_DIR"

header "Tree of env dir"
inspect_dir "$ENV_DIR"
