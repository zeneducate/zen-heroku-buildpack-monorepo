#!/usr/bin/env bash
# bin/detect <build-dir> <cache-dir> <env-dir>

set -euo pipefail

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

header() { echo "-----> $*"; }
log()    { echo "       $*"; }

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"

header "Making api/ root and web bin/ public/ dist/ into web/"

log "Moving api/ staging area"
mv "$BUILD_DIR/api"/* "$STAGE"

log "Creating web/ staging area"
mkdir -p "$BUILD_DIR/web"

log "Moving dist/ bin/ public/ to web/ staging area"
mv "$BUILD_DIR/dist" "$BUILD_DIR/web/"
mv "$BUILD_DIR/bin" "$BUILD_DIR/web/"
mv "$BUILD_DIR/public" "$BUILD_DIR/web/"

log "Removing all other files from build directory"
rm -rf "$BUILD_DIR"/*

log "Moving staging area back to build directory"
mv "$STAGE"/* "$BUILD_DIR/"

log "Successfully restructured build directory"
