#!/usr/bin/env bash
# bin/detect <build-dir> <cache-dir> <env-dir>

set -euo pipefail

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

header() { echo "-----> $*"; }
log()    { echo "       $*"; }

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"

header "Making web/ root and api/ subdirectory"

log "Moving api/ into /web"
mv "${BUILD_DIR}/api" "${BUILD_DIR}/web/"

log "Moving web/ contents to stage directory"
mv "${BUILD_DIR}/web" "${STAGE}"

log "Removing all contents from root of app directory"
rm -rf "${BUILD_DIR}"/*

log "Copying contents of web/ to root of app directory"
mv "${STAGE}/web"/* "${BUILD_DIR}"

log "Copied web to root of app successfully"
