#!/usr/bin/env bash
# bin/detect <build-dir> <cache-dir> <env-dir>

set -euo pipefail

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"

echo "Moving api/ into /web"
mv "${BUILD_DIR}/api" "${BUILD_DIR}/web/"

echo "Moving web/ contents to stage directory"
mv "${BUILD_DIR}/web" "${STAGE}"

echo "Removing all contents from root of app directory"
rm -rf "${BUILD_DIR}"/*

echo "Copying contents of web/ to root of app directory"
mv "${STAGE}/web"/* "${BUILD_DIR}"

echo "Copied web to root of app successfully"

ls -1 "${BUILD_DIR}"
